      <bpmn:outgoing>Flow_00zv4yz</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="repairStory" name="Repair Story" camunda:assignee="${author}">
      <bpmn:incoming>Flow_0aiw0wh</bpmn:incoming>
      <bpmn:outgoing>Flow_15u3tbg</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0rrwtk5" sourceRef="sendNotificationReject" targetRef="sendRejectionEmail" />
    <bpmn:sequenceFlow id="Flow_0aiw0wh" sourceRef="sendRejectionEmail" targetRef="repairStory" />
    <bpmn:sequenceFlow id="Flow_1lb0lre" sourceRef="StartEvent_1" targetRef="adminReview" />
    <bpmn:sequenceFlow id="Flow_00zv4yz" sourceRef="sendNotificationRepairStory" targetRef="adminReview" />
    <bpmn:sequenceFlow id="Flow_0krrbzf" sourceRef="adminReview" targetRef="decisionGateway" />
    <bpmn:sequenceFlow id="Flow_1juo9bn" sourceRef="updateStatusApproved" targetRef="sendApprovedEmail" />
    <bpmn:sequenceFlow id="Flow_0iwznsz" sourceRef="sendApprovedEmail" targetRef="endApproved" />
    <bpmn:sequenceFlow id="Flow_1g4eiy8" sourceRef="saveStory" targetRef="sendNotificationApproved" />
    <bpmn:sequenceFlow id="Flow_0xo6yjf" sourceRef="decisionGateway" targetRef="sendNotificationReject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1d84mr7" sourceRef="decisionGateway" targetRef="saveStory">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15u3tbg" sourceRef="repairStory" targetRef="sendNotificationRepairStory" />
    <bpmn:serviceTask id="sendNotificationApproved" name="Send Notification Approved" camunda:class="com.example.story.workflow.SendNotificationApprovedDelegate">
      <bpmn:incoming>Flow_1g4eiy8</bpmn:incoming>
      <bpmn:outgoing>Flow_0fpm0rz</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0fpm0rz" sourceRef="sendNotificationApproved" targetRef="updateStatusApproved" />
    <bpmn:serviceTask id="saveStory" name="Save Story" camunda:class="com.example.story.workflow.SaveStoryDelegate">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="title">${title}</camunda:inputParameter>
          <camunda:inputParameter name="content">${content}</camunda:inputParameter>
          <camunda:inputParameter name="createdBy">${author}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1d84mr7</bpmn:incoming>
      <bpmn:outgoing>Flow_1g4eiy8</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
