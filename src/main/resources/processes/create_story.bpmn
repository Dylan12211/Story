  <bpmn:collaboration id="CreateStory">
    <bpmn:participant id="Participant_0hd8khw" processRef="Process_1fcsuqq" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1fcsuqq" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_1fpsw2l">
      <bpmn:lane id="Lane_0a591xz" name="System">
        <bpmn:flowNodeRef>sendRejectionEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendApprovedEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>updateStatusApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sendNotificationReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decisionGateway</bpmn:flowNodeRef>
