        <bpmn:flowNodeRef>sendNotificationApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>saveStory</bpmn:flowNodeRef>
        <bpmn:childLaneSet id="LaneSet_1y0uarv" />
      </bpmn:lane>
      <bpmn:lane id="Lane_0ylhwp0" name="Admin">
        <bpmn:flowNodeRef>adminReview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1ceu3yu" name="User">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>repairStory</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="sendRejectionEmail" name="Send Rejection Email" camunda:class="com.example.story.workflow.SendEmailDelegate">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="emailType">REJECTED</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0rrwtk5</bpmn:incoming>
      <bpmn:outgoing>Flow_0aiw0wh</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="StartEvent_1" name="Create Story">
      <bpmn:outgoing>Flow_1lb0lre</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="adminReview" name="Admin Review" camunda:formKey="admin-review" camunda:candidateGroups="ROLE_ADMIN" camunda:dueDate="${dateTime().plusDays(2).toDate()}" camunda:priority="100">
      <bpmn:incoming>Flow_1lb0lre</bpmn:incoming>
      <bpmn:incoming>Flow_00zv4yz</bpmn:incoming>
      <bpmn:outgoing>Flow_0krrbzf</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="sendApprovedEmail" name="Send Approved Email" camunda:class="com.example.story.workflow.SendEmailDelegate">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="emailType">APPROVED</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1juo9bn</bpmn:incoming>
      <bpmn:outgoing>Flow_0iwznsz</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="updateStatusApproved" name="Publish Story" camunda:class="com.example.story.workflow.UpdateStatusDelegate">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="status">PUBLISHED</camunda:inputParameter>
          <camunda:inputParameter name="emailType">APPROVED</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0fpm0rz</bpmn:incoming>
      <bpmn:outgoing>Flow_1juo9bn</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endApproved" name="Story Published">
      <bpmn:incoming>Flow_0iwznsz</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="sendNotificationReject" name="Send Notification Reject" camunda:class="com.example.story.workflow.SendNotificationRejectDelegate">
      <bpmn:incoming>Flow_0xo6yjf</bpmn:incoming>
      <bpmn:outgoing>Flow_0rrwtk5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="decisionGateway" name="Approved?">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_0krrbzf</bpmn:incoming>
      <bpmn:outgoing>Flow_0xo6yjf</bpmn:outgoing>
      <bpmn:outgoing>Flow_1d84mr7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="sendNotificationRepairStory" name="Send Notification Repair Story" camunda:class="com.example.story.workflow.SendNotificationRepairStoryDelegate">
